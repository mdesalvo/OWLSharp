<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyTitle>OWLSharp.Test</AssemblyTitle>
        <AssemblyName>OWLSharp.Test</AssemblyName>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <Version>5.0.2</Version>
        <Authors>Marco De Salvo</Authors>
        <Copyright>Marco De Salvo</Copyright>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Product>OWLSharp</Product>
        <Description>OWLSharp unit testing suite</Description>
        <Title>OWLSharp.Test</Title>
    </PropertyGroup>
    <ItemGroup>
		<PackageReference Include="coverlet.collector" Version="10.1.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
        <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
        <PackageReference Include="WireMock.Net.Minimal" Version="2.35.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\OWLSharp\OWLSharp.csproj" />
    </ItemGroup>
</Project>